    .loc "v0/03-compare.dss" 12
    LOADB r0, true
    JMPF r0, L0
    LOADB r0, false
    JMPF r0, L0
    LOADB r0, true
    JMP L1
  L0:
    LOADB r0, false
  L1:
    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 13
    LOADB r0, false
    JMPT r0, L2
    LOADI r0, 7
    JMPT r0, L2
    LOADB r0, false
    JMP L3
  L2:
    LOADB r0, true
  L3:
    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 14
    LOADI r0, 3
    LOADI r1, 2
    GT r0, r0, r1
