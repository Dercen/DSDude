    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 3
    LOADI r0, 2
    LOADK r1, 2.0
    EQ r0, r0, r1
    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 4
    LOADK r0, 0.5
