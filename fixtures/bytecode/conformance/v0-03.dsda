    GT r0, r0, r1
    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 5
    LOADI r0, 1
    LOADI r1, 1
    NE r0, r0, r1
    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 6
    LOADI r0, -1
    LOADI r1, -1
    LE r0, r0, r1
    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 7
    LOADI r0, 0
    NOT r0, r0
    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 8
    LOADK r0, 0.5
    NOT r0, r0
    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 9
    LOADUNDEF r0
    NOT r0, r0
    CALLN r0, 1, show_debug_message
    .loc "v0/03-compare.dss" 10
    LOADUNDEF r2
    .loc "v0/03-compare.dss" 11
    MOV r0, r2
