.dsda 0.1
.seed 0

.func ctrl_create 0 3
    .loc "objects/obj_ctrl/create.dss" 1
    LOADK r0, "before"
    CALLN r0, 1, show_debug_message
    .loc "objects/obj_ctrl/create.dss" 2
    LOADI r0, 0
    LOADI r1, 0
    LOADK r2, @obj_stop
    CALLN r0, 3, instance_create
    .loc "objects/obj_ctrl/create.dss" 3
    LOADK r0, "after"
    CALLN r0, 1, show_debug_message
    RET r0, 0
.end

.func stop_create 0 1
    .loc "objects/obj_stop/create.dss" 1
    LOADK r0, "stop"
    CALLN r0, 1, show_debug_message
    .loc "objects/obj_stop/create.dss" 2
    HALT
.end

.object obj_ctrl sprite=- parent=- visible=0 screen=top depth=0
    .event create ctrl_create
.end

.object obj_stop sprite=- parent=- visible=0 screen=top depth=0
    .event create stop_create
.end

.room rm_a 256 192
    .screen top - 0 0
    .screen bottom - 0 0
    .instance obj_ctrl 0 0 top -
    .set top - -
    .set bottom - -
    .sounds -
.end

.first rm_a
