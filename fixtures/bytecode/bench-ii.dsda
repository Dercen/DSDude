.object obj_bench sprite=- parent=- visible=0 screen=top depth=0
    .slot s0 0
    .slot s1 1
    .slot s2 2
    .slot s3 3
    .event create bench_create
    .event step bench_step
.end

.room rm_bench 256 192
    .screen top - 0 0
    .screen bottom - 0 0
    .instance obj_bench 0 0 top -
    .set top - -
    .set bottom - -
    .sounds -
.end

.first rm_bench
