.dsda 0.1
.seed 0

.func __main 0 3
    .loc "v1/01-strings.dss" 1
    LOADK r0, "Hello"
    .loc "v1/01-strings.dss" 2
    LOADK r1, ", DS"
    ADD r1, r0, r1
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 3
    MOV r1, r0
    CALLN r1, 1, string_length
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 4
    MOV r1, r0
    LOADI r2, 1
    CALLN r1, 2, string_char_at
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 5
    MOV r1, r0
    LOADI r2, 9
    CALLN r1, 2, string_char_at
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 6
    MOV r1, r0
    CALLN r1, 1, string_upper
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 7
    LOADK r1, "ABC def"
    CALLN r1, 1, string_lower
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 8
    LOADK r1, "ab"
    LOADI r2, 3
    CALLN r1, 2, string_repeat
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 9
    LOADK r1, "A"
    CALLN r1, 1, ord
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 10
    LOADI r1, 66
    CALLN r1, 1, chr
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 11
    LOADK r1, "12"
    CALLN r1, 1, real
    ADDI r1, r1, 1
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 12
    LOADK r1, "-2.5"
    CALLN r1, 1, real
    MULI r1, r1, 2
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 13
    LOADK r1, "n="
    LOADK r2, 0.125
    CALLN r2, 1, string
    CONCAT r1, r1, r2
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 14
    LOADK r1, "héllo"
    LEN r1, r1
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 15
    LOADK r1, "b"
    LOADK r2, "a"
    GT r1, r1, r2
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 16
    LOADK r1, "abc"
    MOV r2, r1
    LOADK r2, "ab"
    LOADK r0, "c"
    CONCAT r2, r2, r0
    EQ r1, r1, r2
    CALLN r1, 1, show_debug_message
    .loc "v1/01-strings.dss" 17
    LOADB r1, true
    TOSTR r1, r1
    LOADUNDEF r2
    TOSTR r2, r2
    ADD r1, r1, r2
    CALLN r1, 1, show_debug_message
    RET r0, 0
.end
