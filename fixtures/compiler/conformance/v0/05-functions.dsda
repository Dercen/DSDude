.dsda 0.1
.seed 0
.global count

.func __main 0 3
    .loc "v0/05-functions.dss" 12
    LOADI r0, 0
    SETGLOB r0, count
    .loc "v0/05-functions.dss" 13
    LOADI r0, 1
    LOADI r1, 2
    CALL r0, add
    CALLN r0, 1, show_debug_message
    .loc "v0/05-functions.dss" 14
    LOADI r0, 5
    LOADI r1, 10
    CALL r0, add
    CALLN r0, 1, show_debug_message
    .loc "v0/05-functions.dss" 15
    LOADI r0, 6
    CALL r0, fact
    CALLN r0, 1, show_debug_message
    .loc "v0/05-functions.dss" 16
    CALL r0, bump
    .loc "v0/05-functions.dss" 17
    CALL r0, bump
    .loc "v0/05-functions.dss" 18
    GETGLOB r0, count
    CALLN r0, 1, show_debug_message
    .loc "v0/05-functions.dss" 19
    LOADI r0, 3
    LOADI r1, 9
    LOADI r2, 4
    CALLN r0, 3, max
    CALLN r0, 1, show_debug_message
    .loc "v0/05-functions.dss" 20
    LOADK r0, -2.5
    CALLN r0, 1, floor
    CALLN r0, 1, show_debug_message
    .loc "v0/05-functions.dss" 21
    LOADK r0, -2.5
    CALLN r0, 1, round
    CALLN r0, 1, show_debug_message
    .loc "v0/05-functions.dss" 22
    LOADI r0, -7
    CALLN r0, 1, abs
    CALLN r0, 1, show_debug_message
    RET r0, 0
.end

.func add 2 3
    .loc "v0/05-functions.dss" 3
    ADD r2, r0, r1
    RET r2, 1
.end

.func fact 1 3
    .loc "v0/05-functions.dss" 6
    LOADI r1, 1
    CMPJ r0, r1, 3
    JMP L0
    LOADI r1, 1
    RET r1, 1
  L0:
    .loc "v0/05-functions.dss" 7
    SUBI r2, r0, 1
    CALL r2, fact
    MUL r1, r0, r2
    RET r1, 1
.end

.func bump 0 1
    .loc "v0/05-functions.dss" 10
    GETGLOB r0, count
    ADDI r0, r0, 1
    SETGLOB r0, count
    RET r0, 0
.end
