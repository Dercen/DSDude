{
  "name": "@dsdude/ide",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "DSDude IDE (Electron shell). CJS main/preload: never add \"type\": \"module\".",
  "main": "./out/main/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./panels": "./src/renderer/panels/index.ts",
    "./mock-host": "./src/renderer/mock-host/index.ts"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run --pool=threads --maxWorkers=2 && npm run test:browser",
    "test:e2e": "playwright test",
    "test:node": "vitest run --pool=threads --maxWorkers=2",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "dockview": "8.3.1",
    "dockview-react": "8.3.1",
    "dompurify": "3.4.15",
    "electron-updater": "6.8.9",
    "immer": "11.1.18",
    "marked": "14.0.0",
    "monaco-editor": "0.57.0",
    "pixi.js": "8.21.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@dsdude/asset-pipeline": "0.1.0",
    "@dsdude/compiler": "0.1.0",
    "@dsdude/editor-core": "0.1.0",
    "@dsdude/ipc-contract": "0.1.0",
    "@dsdude/language-service": "0.1.0",
    "@dsdude/monaco-dss": "0.1.0",
    "@dsdude/project-format": "0.1.0",
    "@dsdude/toolchain": "0.1.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "5.0.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6"
  }
}
